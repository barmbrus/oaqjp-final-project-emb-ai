import requests

URL = 'https://sn-watson-emotion.labs.skills.network/v1/watson.runtime.nlp.v1/NlpService/EmotionPredict'
HEADERS = {"grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"}

def emotion_detector(text_to_analyze):
    req_json =  { "raw_document": { "text": text_to_analyze } }
    res = requests.post(URL, headers=HEADERS, json=req_json)

    if res.status_code == 400:
        return { "anger": None, "disgust": None, "dominant_emotion": None, "fear": None, "joy": None, "sadness": None }

    res_json = res.json()


    emotions = res_json["emotionPredictions"][0]["emotion"]
    dominant_emotion = None
    dominant_emotion_score = 0

    for emotion in emotions:
        if emotions[emotion] > dominant_emotion_score:
            dominant_emotion = emotion
            dominant_emotion_score = emotions[emotion]
    
    emotions['dominant_emotion'] = dominant_emotion

    return emotions